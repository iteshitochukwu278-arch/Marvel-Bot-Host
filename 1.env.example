# Required host bot credentials — set these in Render Environment, never commit real values.
BOT_TOKEN=REPLACE_WITH_HOST_BOT_TOKEN
OWNER_ID=REPLACE_WITH_OWNER_TELEGRAM_ID
ADMIN_ID=REPLACE_WITH_ADMIN_TELEGRAM_ID

# Optional customer-facing settings
UPDATE_CHANNEL=
YOUR_USERNAME=
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Multi-bot fleet
# Keep this stable after deployment: it encrypts stored customer bot tokens.
FLEET_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MAX_BOTS_PER_USER=5

# Existing cloud persistence (optional)
MONGO_URI=
MONGO_DB_NAME=hostbot
PERSIST_MAX_FILE_MB=25

# Optional customer database pool; configure only your own valid connection strings.
CUSTOMER_DB_1=
CUSTOMER_DB_2=
CUSTOMER_DB_3=
CUSTOMER_DB_4=
CUSTOMER_DB_5=
DB_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DB_MAX_PER_SERVER=0
# Render has no Docker: use subprocess mode (trusted uploaders only).
# On a Docker-capable VPS use BOT_EXECUTION_MODE=docker and drop the next line.
BOT_EXECUTION_MODE=subprocess
BOT_ALLOW_UNSAFE_SUBPROCESS=true
BOT_DOCKER_IMAGE=python:3.12-slim
BOT_CPU_QUOTA=1.0
BOT_DOCKER_NETWORK=bridge
BOT_MEMORY_MB=512
BOT_PIDS_LIMIT=64
BOT_MAX_RESTARTS=5
BOT_RESTART_WINDOW_SECONDS=300
BOT_BACKUP_INTERVAL_SECONDS=86400
BOT_BACKUP_RETENTION=7
